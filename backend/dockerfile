# → Use a smaller slim image
FROM python:3.10-slim

# → Set working dir
WORKDIR /app

# → Copy only your dependencies first (cache‐friendly)
COPY requirements.txt ./

# → Install deps in one shot
RUN pip install --no-cache-dir -r requirements.txt

# → Copy rest of your code
COPY . .

# → Make sure Python modules resolve
ENV PYTHONPATH=/app

# → Document the port
EXPOSE 8000

# → Default to running Uvicorn on main:app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
